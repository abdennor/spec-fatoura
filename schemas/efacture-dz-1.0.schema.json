{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-facture-dz.github.io/spec/schemas/efacture-dz-1.0.schema.json",
  "title": "e-facture-dz Invoice Schema",
  "description": "JSON Schema for Algeria's e-invoicing open standard (version 1.0)",
  "type": "object",
  "required": ["efacture"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "efacture": {
      "type": "object",
      "required": ["version", "type", "id", "issueDate", "currency", "seller", "buyer", "lines", "totals"],
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0",
          "description": "Protocol version"
        },
        "type": {
          "type": "string",
          "enum": ["invoice", "credit_note", "debit_note", "proforma"],
          "description": "Document type"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9\\-]+$",
          "description": "Unique invoice identifier"
        },
        "issueDate": {
          "type": "string",
          "format": "date",
          "description": "Invoice issue date (ISO 8601: YYYY-MM-DD)"
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "description": "Payment due date"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$",
          "default": "fr",
          "description": "ISO 639-1 language code"
        },
        "seller": { "$ref": "#/$defs/party" },
        "buyer": { "$ref": "#/$defs/party" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lineItem" },
          "description": "Invoice line items"
        },
        "totals": { "$ref": "#/$defs/totals" },
        "payment": { "$ref": "#/$defs/payment" },
        "notes": {
          "type": "string",
          "description": "Free-text notes"
        },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/attachment" },
          "description": "Embedded documents"
        },
        "metadata": { "$ref": "#/$defs/metadata" },
        "signature": { "$ref": "#/$defs/signature" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "party": {
      "type": "object",
      "required": ["name", "nif", "address"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Legal business name (raison sociale)"
        },
        "legalForm": {
          "type": "string",
          "enum": ["SARL", "EURL", "SPA", "SPAS", "SPASU", "SNC", "SCS", "GIE", "EI", "EPIC", "OTHER"],
          "description": "Legal form of the entity"
        },
        "activityNature": {
          "type": "string",
          "description": "Nature/type of business activity"
        },
        "nif": {
          "type": "string",
          "pattern": "^[0-9]{15,20}$",
          "description": "Numéro d'Identification Fiscale"
        },
        "registrations": {
          "type": "object",
          "properties": {
            "rc": {
              "type": "string",
              "pattern": "^[0-9]{2}/[0-9]{2}-[0-9]{7}[A-Z][0-9]{2}$",
              "description": "Registre de Commerce"
            },
            "nis": {
              "type": "string",
              "pattern": "^[0-9]{11,15}$",
              "description": "Numéro d'Identification Statistique"
            },
            "ai": {
              "type": "string",
              "pattern": "^[0-9]{11}$",
              "description": "Article d'Imposition"
            }
          },
          "additionalProperties": false
        },
        "capitalSocial": {
          "type": "number",
          "minimum": 0,
          "description": "Share capital amount"
        },
        "address": { "$ref": "#/$defs/address" },
        "contact": { "$ref": "#/$defs/contact" }
      },
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "required": ["street", "city", "country"],
      "properties": {
        "street": {
          "type": "string",
          "minLength": 1,
          "description": "Street address"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "description": "City name"
        },
        "postalCode": {
          "type": "string",
          "description": "Postal/ZIP code"
        },
        "state": {
          "type": "string",
          "description": "State/Province/Wilaya"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code"
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "description": "Primary telephone number"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address"
        },
        "fax": {
          "type": "string",
          "description": "Fax number"
        }
      },
      "additionalProperties": false
    },
    "lineItem": {
      "type": "object",
      "required": ["description", "amountBeforeTax", "taxes", "total"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Item/service description"
        },
        "amountBeforeTax": {
          "type": "number",
          "minimum": 0,
          "description": "Total amount before tax (HT)"
        },
        "taxes": {
          "type": "array",
          "items": { "$ref": "#/$defs/lineTax" },
          "description": "All applicable taxes"
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "description": "Line total including all taxes"
        },
        "metadata": {
          "type": "object",
          "description": "Free-form object for additional line details"
        }
      },
      "additionalProperties": false
    },
    "lineTax": {
      "type": "object",
      "required": ["code", "rate", "amount"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Tax code identifier (e.g., TVA_19, TAP)"
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "description": "Tax rate percentage"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Calculated tax amount"
        }
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": ["totalBeforeTax", "taxes", "totalTax", "total"],
      "properties": {
        "totalBeforeTax": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of line items before tax (HT)"
        },
        "taxes": {
          "type": "array",
          "items": { "$ref": "#/$defs/taxEntry" },
          "description": "Breakdown of all taxes"
        },
        "totalTax": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of all tax amounts"
        },
        "stampDuty": { "$ref": "#/$defs/stampDuty" },
        "total": {
          "type": "number",
          "minimum": 0,
          "description": "Grand total including all taxes and stamp duty"
        },
        "amountInWords": {
          "type": "string",
          "description": "Total amount written in words"
        }
      },
      "additionalProperties": false
    },
    "taxEntry": {
      "type": "object",
      "required": ["code", "name", "base", "rate", "amount"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Tax code identifier"
        },
        "name": {
          "type": "string",
          "description": "Tax name"
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "description": "Taxable base amount"
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "description": "Tax rate percentage"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Calculated tax amount"
        }
      },
      "additionalProperties": false
    },
    "stampDuty": {
      "type": "object",
      "required": ["base", "rate", "amount"],
      "properties": {
        "base": {
          "type": "number",
          "minimum": 0,
          "description": "Amount on which stamp duty is calculated"
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "description": "Stamp duty rate as percentage"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Calculated stamp duty amount"
        }
      },
      "additionalProperties": false
    },
    "payment": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["cash", "bank_transfer", "check", "credit_card", "wire_transfer"],
          "description": "Payment method"
        },
        "terms": {
          "type": "string",
          "description": "Payment terms"
        },
        "bankAccount": {
          "type": "object",
          "properties": {
            "bankName": { "type": "string" },
            "bankCode": { "type": "string" },
            "accountNumber": { "type": "string" },
            "iban": { "type": "string" },
            "bic": { "type": "string" }
          },
          "additionalProperties": false
        },
        "instructions": {
          "type": "string",
          "description": "Payment instructions"
        }
      },
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "required": ["filename", "mimeType"],
      "properties": {
        "filename": {
          "type": "string",
          "description": "File name"
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type"
        },
        "description": {
          "type": "string",
          "description": "Description of the attachment"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Base64-encoded file content"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when invoice was generated (ISO 8601)"
        },
        "schemaVersion": {
          "type": "string",
          "description": "Version of the schema used"
        },
        "software": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the generating software"
            },
            "version": {
              "type": "string",
              "description": "Software version"
            },
            "vendor": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Legal name of the software vendor"
                },
                "website": {
                  "type": "string",
                  "format": "uri",
                  "description": "Vendor website URL"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "description": "Vendor contact email"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["RSA-SHA256", "ECDSA-P256"],
          "description": "Signature algorithm"
        },
        "certificate": {
          "type": "string",
          "description": "Base64-encoded X.509 certificate"
        },
        "value": {
          "type": "string",
          "description": "Base64-encoded signature value"
        },
        "signedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when signed"
        }
      },
      "additionalProperties": false
    }
  }
}
